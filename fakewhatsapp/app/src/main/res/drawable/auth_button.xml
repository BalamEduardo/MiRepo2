<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/auth_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/auth_disabled" />
                    <corners android:radius="@dimen/auth_radius" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/auth_accent" />
                    <corners android:radius="@dimen/auth_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
