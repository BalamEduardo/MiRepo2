{
  "name": "facerecognition",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --no-bundler",
    "ios": "expo run:ios --no-bundler",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "build:face-model": "node scripts/build-face-engine.cjs",
    "postinstall": "patch-package --error-on-fail",
    "test": "node --test"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-media-library": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-face-detector": "2.1.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
