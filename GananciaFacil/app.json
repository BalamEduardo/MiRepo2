{
  "expo": {
    "name": "DineroMio",
    "slug": "dineromio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dineromio-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/dineromio-icon.png",
        "backgroundColor": "#F5F5F7"
      }
    },
    "web": {
      "favicon": "./assets/dineromio-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/dineromio-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7"
        }
      ]
    ]
  }
}
