{
  "expo": {
    "name": "Ganancia Fácil",
    "slug": "ganancia-facil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ganancia-facil-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/ganancia-facil-icon.png",
        "backgroundColor": "#FFF8EC"
      }
    },
    "web": {
      "favicon": "./assets/ganancia-facil-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/ganancia-facil-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EC"
        }
      ]
    ]
  }
}
